# shopsignscanner 上报后端 —— 配置样例
#
# 复制成 api-server/.env 后填写；**这个文件绝不提交真实值**（.gitignore 已忽略 .env）。
# 所有项都能用同名环境变量覆盖（systemd Environment= / docker -e 优先于 .env）。

# ---------------------------------------------------------------- HTTP
# 只监听回环地址：真实入口是 nginx 的 location /api/ingest/ 反代
HOST=127.0.0.1
PORT=3200
# 是否信任 X-Forwarded-For（HOST 为回环时默认 true；直接对外监听时必须设 false）
TRUST_PROXY=true
LOG_LEVEL=info

# ---------------------------------------------------------------- 鉴权
INGEST_ENABLED=true
# HMAC-SHA256 共享密钥，必须与每个客户端 mod 配置里的 apiSecret 完全一致。
# 生成：openssl rand -hex 32
INGEST_SHARED_SECRET=
# 允许上报的来源 IP，逗号分隔；留空表示不限制（仍受 HMAC 保护）。
# 走 nginx 时这里填的是**客户端真实 IP**（nginx 传 X-Forwarded-For）。
INGEST_ALLOWED_IPS=
# 时间戳允许偏差（毫秒），防重放
INGEST_REPLAY_WINDOW_MS=300000

# ---------------------------------------------------------------- 限流
INGEST_RATE_LIMIT=600
INGEST_RATE_WINDOW_MS=60000

# ---------------------------------------------------------------- 上限
INGEST_MAX_SHOPS=200
INGEST_MAX_HEARTBEAT_KEYS=5000
INGEST_MAX_BODY_BYTES=1048576

# ---------------------------------------------------------------- 数据库
# 本服务只做「写」，账号只需 shop.shop_signs 的 SELECT, INSERT, UPDATE：
#   CREATE USER 'shop_ingest'@'127.0.0.1' IDENTIFIED BY '<强口令>';
#   GRANT SELECT, INSERT, UPDATE ON shop.shop_signs TO 'shop_ingest'@'127.0.0.1';
# 与 MySQL 同机部署时一律用 127.0.0.1，不要对外暴露 3306。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=shop_ingest
DB_PASSWORD=
DB_NAME=shop
DB_TABLE=shop_signs
DB_POOL=4
